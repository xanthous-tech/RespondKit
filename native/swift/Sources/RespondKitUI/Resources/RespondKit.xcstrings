        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত হয়নি — নিরাপদে আবার চেষ্টা করতে পারেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmat: pots tornar-ho a provar sense risc"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepotvrzeno – můžete bezpečně zkusit znovu"
