        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಭಾಷಣೆಯ ಇತಿಹಾಸವನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಇನ್ನಷ್ಟು ಬಟನ್ ಅನ್ನು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
