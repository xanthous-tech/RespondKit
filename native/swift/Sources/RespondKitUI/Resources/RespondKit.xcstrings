        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପୁଣି ସଂଯୋଗ କରାଯାଉଛି। ଆପଣଙ୍କ ବିଦ୍ୟମାନ ବାର୍ତ୍ତାଗୁଡ଼ିକ ଏବେ ବି ଉପଲବ୍ଧ।"
