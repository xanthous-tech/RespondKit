    "respondkit_session_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة الدعم. أعد الاتصال للمتابعة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесията ви с поддръжката изтече. Свържете се отново, за да продължите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সহায়তা সেশনের মেয়াদ শেষ হয়ে গেছে। চালিয়ে যেতে আবার সংযোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessió d'assistència ha caducat. Torna a connectar per continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace podpory vypršela. Pro pokračování se znovu připojte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din supportsession er udløbet. Opret forbindelse igen for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Support-Sitzung ist abgelaufen. Neu verbinden, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία υποστήριξης έληξε. Επανασυνδεθείτε για να συνεχίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your support session expired. Reconnect to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de soporte ha caducado. Reconecta para continuar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugiseanss aegus. Jätkamiseks ühenda uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukiistuntosi on vanhentunut. Jatka yhdistämällä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire na ang session mo sa suporta. Kumonektang muli para magpatuloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session d’assistance a expiré. Reconnectez-vous pour continuer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session de soutien a expiré. Reconnectez-vous pour continuer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું સપોર્ટ સેશન સમાપ્ત થઈ ગયું છે. ચાલુ રાખવા માટે ફરી કનેક્ટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פג תוקף הסשן מול התמיכה. צריך להתחבר מחדש כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सहायता सेशन खत्म हो गया है। जारी रखने के लिए फिर से कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša je sesija podrške istekla. Ponovno se povežite za nastavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ügyfélszolgálati munkamenet lejárt. A folytatáshoz csatlakozzon újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi dukungan Anda telah berakhir. Hubungkan ulang untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione di assistenza è scaduta. Riconnettiti per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートセッションの有効期限が切れました。続けるには再接続してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬೆಂಬಲ ಸೆಷನ್‌ನ ಅವಧಿ ಮುಗಿದಿದೆ. ಮುಂದುವರಿಯಲು ಮರುಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고객 지원 세션이 만료되었습니다. 계속하려면 다시 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagalbos sesija baigėsi. Prisijunkite iš naujo, kad galėtumėte tęsti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu atbalsta sesija ir beigusies. Lai turpinātu, savienojiet vēlreiz."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പിന്തുണ സെഷൻ കാലഹരണപ്പെട്ടു. തുടരാൻ വീണ്ടും കണക്റ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे सहाय्य सत्र कालबाह्य झाले. सुरू ठेवण्यासाठी पुन्हा कनेक्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi sokongan anda telah tamat tempoh. Sambung semula untuk meneruskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kundestøtteøkten har utløpt. Koble til på nytt for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je supportsessie is verlopen. Maak opnieuw verbinding om door te gaan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ସହାୟତା ସେସନ୍‌ର ମିଆଦ ଶେଷ ହୋଇଛି। ଜାରି ରଖିବାକୁ ପୁଣି ସଂଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਸਹਾਇਤਾ ਸੈਸ਼ਨ ਦੀ ਮਿਆਦ ਪੁੱਗ ਗਈ ਹੈ। ਜਾਰੀ ਰੱਖਣ ਲਈ ਦੁਬਾਰਾ ਕਨੈਕਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja czatu pomocy wygasła. Połącz ponownie, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão de suporte expirou. Reconecte para continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua sessão de suporte expirou. Restabeleça a ligação para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea de asistență a expirat. Reconectați-vă pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс поддержки истёк. Переподключитесь, чтобы продолжить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Relácia podpory vypršala. Ak chcete pokračovať, znova sa pripojte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja podpore je potekla. Za nadaljevanje se znova povežite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша сесија подршке је истекла. Поново се повежите да бисте наставили."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din supportsession har gått ut. Anslut igen för att fortsätta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆதரவு அமர்வு காலாவதியாகிவிட்டது. தொடர மீண்டும் இணையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మద్దతు సెషన్ గడువు ముగిసింది. కొనసాగించడానికి మళ్లీ కనెక్ట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันฝ่ายสนับสนุนหมดอายุแล้ว เชื่อมต่ออีกครั้งเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek oturumunuzun süresi doldu. Devam etmek için yeniden bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс підтримки завершився. Перепідключіться, щоб продовжити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے سپورٹ سیشن کی میعاد ختم ہو گئی۔ جاری رکھنے کے لیے دوبارہ منسلک ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên hỗ trợ của bạn đã hết hạn. Hãy kết nối lại để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客服会话已过期。请重新连接以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "客服工作階段已過期，請重新連線以繼續。"
          }
        }
      }
    },
