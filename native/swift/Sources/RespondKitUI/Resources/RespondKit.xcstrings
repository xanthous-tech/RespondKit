        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте отново, за да възстановите историята си с поддръжката."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সহায়তার ইতিহাস ফিরে পেতে আবার সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a iniciar la sessió per recuperar l'historial d'assistència."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se znovu a obnovte historii komunikace s podporou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind igen for at gendanne din supporthistorik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich erneut an, um deinen Support-Verlauf wiederherzustellen."
