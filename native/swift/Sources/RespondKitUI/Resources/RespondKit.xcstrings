      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إلغاء جلسة الدعم السابقة. ستنتهي صلاحيتها تلقائيًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предишната сесия за поддръжка не можа да бъде прекратена. Тя ще изтече автоматично."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগের সহায়তা সেশনটি বাতিল করা যায়নি। এটি স্বয়ংক্রিয়ভাবে মেয়াদোত্তীর্ণ হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut revocar la sessió d'assistència anterior. Caducarà automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí relaci podpory se nepodařilo zrušit. Platnost vyprší automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tidligere supportsession kunne ikke tilbagekaldes. Den udløber automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige Support-Sitzung konnte nicht widerrufen werden. Sie läuft automatisch ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάκληση της προηγούμενης συνεδρίας υποστήριξης. Θα λήξει αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous support session could not be revoked. It will expire automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo revocar la sesión de soporte anterior. Caducará automáticamente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eelmist tugiseanssi ei õnnestunud tühistada. See aegub automaatselt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellistä tukiistuntoa ei voitu peruuttaa. Se vanhenee automaattisesti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabawi ang naunang support session. Kusa itong mag-e-expire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session d'assistance précédente n'a pas pu être révoquée. Elle expirera automatiquement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de soutien précédente n'a pas pu être révoquée. Elle expirera automatiquement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અગાઉનું સપોર્ટ સત્ર રદ કરી શકાયું નથી. તે આપમેળે સમાપ્ત થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לבטל את סשן התמיכה הקודם. התוקף שלו יפוג אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछला सहायता सत्र रद्द नहीं किया जा सका। यह अपने आप समाप्त हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prethodnu sesiju podrške nije bilo moguće opozvati. Automatski će isteći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előző ügyfélszolgálati munkamenetet nem sikerült visszavonni. Automatikusan lejár."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi dukungan sebelumnya tidak dapat dicabut. Sesi akan berakhir secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile revocare la sessione di assistenza precedente. Scadrà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のサポートセッションを取り消せませんでした。自動的に期限切れになります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಿಂದಿನ ಬೆಂಬಲ ಸೆಷನ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಅದು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅವಧಿ ಮುಗಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 지원 세션을 취소하지 못했습니다. 자동으로 만료됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankstesnės pagalbos sesijos atšaukti nepavyko. Ji baigsis automatiškai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepriekšējo atbalsta sesiju neizdevās atsaukt. Tās derīgums beigsies automātiski."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുമ്പത്തെ സപ്പോർട്ട് സെഷൻ റദ്ദാക്കാനായില്ല. അത് സ്വയമേവ കാലഹരണപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील सहाय्य सत्र रद्द करता आले नाही. ते आपोआप कालबाह्य होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi sokongan sebelumnya tidak dapat dibatalkan. Sesi itu akan tamat tempoh secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forrige støtteøkten kunne ikke tilbakekalles. Den utløper automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige supportsessie kon niet worden ingetrokken. Deze verloopt automatisch."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପୂର୍ବ ସହାୟତା ସେସନ୍ ବାତିଲ କରାଯାଇପାରିଲା ନାହିଁ। ଏହା ସ୍ୱୟଂଚାଳିତ ଭାବେ ସମାପ୍ତ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲਾ ਸਹਾਇਤਾ ਸੈਸ਼ਨ ਰੱਦ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ। ਇਹ ਆਪਣੇ ਆਪ ਖਤਮ ਹੋ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się unieważnić poprzedniej sesji pomocy. Wygaśnie ona automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível revogar a sessão de suporte anterior. Ela expirará automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível revogar a sessão de suporte anterior. Irá expirar automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea de asistență anterioară nu a putut fi revocată. Va expira automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отозвать предыдущий сеанс поддержки. Он истечёт автоматически."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predchádzajúcu reláciu podpory sa nepodarilo zrušiť. Jej platnosť automaticky vyprší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejšnje seje podpore ni bilo mogoče preklicati. Samodejno bo potekla."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Претходна сесија подршке није могла да буде опозвана. Аутоматски ће истећи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tidigare supportsessionen kunde inte återkallas. Den upphör automatiskt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முந்தைய ஆதரவு அமர்வைத் திரும்பப்பெற முடியவில்லை. அது தானாகவே காலாவதியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మునుపటి సపోర్ట్ సెషన్‌ను రద్దు చేయడం సాధ్యపడలేదు. అది ఆటోమేటిక్‌గా గడువు ముగుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเพิกถอนเซสชันการสนับสนุนก่อนหน้าได้ เซสชันจะหมดอายุโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki destek oturumu iptal edilemedi. Otomatik olarak sona erecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкликати попередній сеанс підтримки. Він завершиться автоматично."
