    "respondkit_identity_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت هوية الدعم في علامة تبويب أخرى. أعد الاتصال لإعادة تحميل حسابك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Самоличността за поддръжка е променена в друг раздел. Свържете се отново, за да презаредите акаунта си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি ট্যাবে সহায়তার পরিচয় পরিবর্তিত হয়েছে। আপনার অ্যাকাউন্ট আবার লোড করতে পুনরায় সংযোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La identitat d'assistència ha canviat en una altra pestanya. Torna a connectar per recarregar el teu compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Identita podpory se změnila na jiné kartě. Znovu se připojte a načtěte svůj účet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Supportidentiteten blev ændret i en anden fane. Opret forbindelse igen for at genindlæse din konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Support-Identität wurde in einem anderen Tab geändert. Neu verbinden, um dein Konto neu zu laden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταυτότητα υποστήριξης άλλαξε σε άλλη καρτέλα. Επανασυνδεθείτε για να φορτώσετε ξανά τον λογαριασμό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support identity changed in another tab. Reconnect to reload your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad de soporte cambió en otra pestaña. Reconecta para volver a cargar tu cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugiidentiteet muutus teisel vahekaardil. Ühenda uuesti, et konto uuesti laadida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuen tunnistetiedot vaihtuivat toisessa välilehdessä. Lataa tilisi uudelleen yhdistämällä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Napalitan ang account sa suporta sa ibang tab. Kumonektang muli para i-reload ang account mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte d’assistance a changé dans un autre onglet. Reconnectez-vous pour recharger votre compte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte de soutien a changé dans un autre onglet. Reconnectez-vous pour recharger votre compte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજા ટૅબમાં સપોર્ટ ઓળખ બદલાઈ ગઈ છે. તમારું એકાઉન્ટ ફરી લોડ કરવા માટે ફરી કનેક્ટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהות התמיכה השתנתה בכרטיסייה אחרת. צריך להתחבר מחדש כדי לטעון מחדש את החשבון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे टैब में सहायता पहचान बदल गई है। अपना खाता फिर से लोड करने के लिए फिर से कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitet za podršku promijenjen je u drugoj kartici. Ponovno se povežite kako biste ponovno učitali račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik lapon megváltozott az ügyfélszolgálati azonosító. Csatlakozzon újra a fiókja újbóli betöltéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitas dukungan berubah di tab lain. Hubungkan ulang untuk memuat ulang akun Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'account di assistenza è cambiato in un'altra scheda. Riconnettiti per ricaricare il tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のタブでサポートのアカウントが切り替わりました。アカウントを再読み込みするには再接続してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮತ್ತೊಂದು ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಬೆಂಬಲ ಖಾತೆ ಬದಲಾಗಿದೆ. ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಮರುಲೋಡ್ ಮಾಡಲು ಮರುಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 탭에서 고객 지원 계정이 변경되었습니다. 계정을 다시 불러오려면 다시 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagalbos tapatybė pasikeitė kitame skirtuke. Prisijunkite iš naujo, kad iš naujo įkeltumėte savo paskyrą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbalsta identitāte tika mainīta citā cilnē. Lai atkārtoti ielādētu savu kontu, savienojiet vēlreiz."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു ടാബിൽ പിന്തുണ അക്കൗണ്ട് മാറി. നിങ്ങളുടെ അക്കൗണ്ട് റീലോഡ് ചെയ്യാൻ വീണ്ടും കണക്റ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसऱ्या टॅबमध्ये सहाय्य खाते बदलले. तुमचे खाते रीलोड करण्यासाठी पुन्हा कनेक्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiti sokongan telah bertukar dalam tab lain. Sambung semula untuk memuatkan semula akaun anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kundestøtteidentiteten ble endret i en annen fane. Koble til på nytt for å laste inn kontoen din igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je supportidentiteit is in een ander tabblad gewijzigd. Maak opnieuw verbinding om je account opnieuw te laden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନ୍ୟ ଏକ ଟ୍ୟାବ୍‌ରେ ସହାୟତା ପରିଚୟ ବଦଳିଯାଇଛି। ଆପଣଙ୍କ ଆକାଉଣ୍ଟ ପୁଣି ଲୋଡ୍ କରିବାକୁ ପୁଣି ସଂଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਹੋਰ ਟੈਬ ਵਿੱਚ ਸਹਾਇਤਾ ਪਛਾਣ ਬਦਲ ਗਈ ਹੈ। ਆਪਣਾ ਖਾਤਾ ਮੁੜ ਲੋਡ ਕਰਨ ਲਈ ਦੁਬਾਰਾ ਕਨੈਕਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tożsamość w czacie pomocy zmieniła się w innej karcie. Połącz ponownie, aby wczytać swoje konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade de suporte mudou em outra aba. Reconecte para recarregar sua conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade de suporte mudou noutro separador. Restabeleça a ligação para recarregar a sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitatea de asistență s-a schimbat în altă filă. Reconectați-vă pentru a reîncărca contul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль поддержки изменён в другой вкладке. Переподключитесь, чтобы заново загрузить аккаунт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Identita podpory sa zmenila na inej karte. Znova sa pripojte a načítajte svoj účet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiteta podpore se je spremenila v drugem zavihku. Znova se povežite, da ponovno naložite svoj račun."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог за подршку је промењен у другој картици. Поново се повежите да бисте поново учитали свој налог."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Supportkontot ändrades i en annan flik. Anslut igen för att läsa in ditt konto på nytt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறொரு தாவலில் ஆதரவுக் கணக்கு மாற்றப்பட்டது. உங்கள் கணக்கை மீண்டும் ஏற்ற மீண்டும் இணையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో ట్యాబ్‌లో మద్దతు ఖాతా మారింది. మీ ఖాతాను మళ్లీ లోడ్ చేయడానికి మళ్లీ కనెక్ట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีฝ่ายสนับสนุนมีการเปลี่ยนแปลงในแท็บอื่น เชื่อมต่ออีกครั้งเพื่อโหลดบัญชีของคุณใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek hesabı başka bir sekmede değişti. Hesabınızı yeniden yüklemek için yeniden bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис підтримки змінено в іншій вкладці. Перепідключіться, щоб перезавантажити свій обліковий запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی دوسرے ٹیب میں سپورٹ اکاؤنٹ تبدیل ہو گیا۔ اپنا اکاؤنٹ دوبارہ لوڈ کرنے کے لیے دوبارہ منسلک ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản hỗ trợ đã thay đổi ở một thẻ khác. Hãy kết nối lại để tải lại tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客服身份已在其他标签页中更改。请重新连接以重新加载您的账户。"
