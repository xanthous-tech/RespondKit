{
  "name": "@respondkit/react-native",
  "version": "0.6.0",
  "description": "Native React Native support conversations for RespondKit",
  "homepage": "https://respondkit.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xanthous-tech/RespondKit.git",
    "directory": "packages/react-native"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/hooks.ts",
    "src/native.ts",
    "src/screen.tsx",
    "src/store.ts",
    "src/files.ts",
    "src/attachment-picker.tsx",
    "android/build.gradle",
    "android/src",
    "ios",
    "RespondKitFiles.podspec",
    "react-native.config.js"
  ],
  "type": "module",
  "sideEffects": [
    "./src/native.ts",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/store.ts",
      "default": "./src/store.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "react-native": "./dist/index.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/store.d.ts",
        "import": "./dist/store.js",
        "default": "./dist/store.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "test": "vp test",
    "build:npm": "vp pack"
  },
  "dependencies": {
    "@respondkit/api-client": "workspace:^",
    "@respondkit/protocol": "workspace:^",
    "linkify-it": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "0.87.1",
    "react-native-device-info": "15.0.2",
    "react-native-get-random-values": "2.0.0",
    "react-native-safe-area-context": "^5.6.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.1",
    "react-native": ">=0.81",
    "react-native-device-info": ">=14",
    "react-native-get-random-values": ">=1.11",
    "react-native-safe-area-context": ">=5"
  }
}
