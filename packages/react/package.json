{
  "name": "@respondkit/react",
  "version": "0.1.0",
  "description": "Embeddable React customer-support widget for RespondKit",
  "keywords": [
    "chat-widget",
    "customer-support",
    "react",
    "respondkit",
    "typescript"
  ],
  "homepage": "https://respondkit.dev",
  "bugs": {
    "url": "https://github.com/xanthous-tech/RespondKit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xanthous-tech/RespondKit.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src/components",
    "src/lib",
    "src/widget/respondkit-widget.tsx",
    "src/widget/message-composer.tsx",
    "src/widget/message-list.tsx",
    "src/widget/theme.ts",
    "src/widget/types.ts",
    "src/widget/use-respondkit.ts",
    "src/index.ts",
    "src/styles.css",
    "src/styles.d.css.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": {
      "types": "./src/styles.d.css.ts",
      "default": "./src/styles.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": {
        "types": "./src/styles.d.css.ts",
        "default": "./src/styles.css"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build:npm": "vp pack",
    "test": "vp test",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@respondkit/api-client": "workspace:^",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
