{
  "name": "@respondkit/protocol",
  "version": "0.1.0",
  "description": "Versioned public protocol for RespondKit customer clients",
  "keywords": [
    "customer-support",
    "respondkit",
    "typescript",
    "zod"
  ],
  "homepage": "https://respondkit.dev",
  "bugs": {
    "url": "https://github.com/xanthous-tech/RespondKit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xanthous-tech/RespondKit.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "src/customer.ts",
    "src/errors.ts",
    "src/ids.ts",
    "src/index.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build:npm": "vp pack",
    "typecheck": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
