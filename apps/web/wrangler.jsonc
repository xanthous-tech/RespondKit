{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "respondkit-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "respondkit.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
