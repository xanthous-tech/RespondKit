{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "respondkit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENVIRONMENT": "development",
    "POSTHOG_ACTIVITY_INBOXES": "{}",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "TRANSLATION_ENABLED_INBOXES": "[]",
    "DISCORD_API_BASE_URL": "https://discord.com/api/v10",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "respondkit",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "name": "respondkit-translation",
      "binding": "TRANSLATION_WORKFLOW",
      "class_name": "TranslationWorkflow",
    },
    {
      "name": "respondkit-message",
      "binding": "MESSAGE_WORKFLOW",
      "class_name": "MessageWorkflow",
    },
  ],
  "env": {
    "staging": {
      "name": "respondkit-api-staging",
      "triggers": { "crons": ["* * * * *"] },
      "routes": [
        {
          "pattern": "api.respondkit.dev",
          "custom_domain": true,
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "POSTHOG_ACTIVITY_INBOXES": "{\"inbox_captioner_public\":{\"host\":\"https://eu.posthog.com\",\"projectId\":57374,\"endpoint\":\"respondkit_customer_activity_v1\",\"version\":2}}",
        "GEMINI_MODEL": "gemini-3.1-flash-lite",
        "TRANSLATION_ENABLED_INBOXES": "[\"inbox_respondkit_test\",\"inbox_captioner_public\"]",
        "DISCORD_API_BASE_URL": "https://discord.com/api/v10",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "respondkit-staging",
          "database_id": "cbd8c612-bd74-4a95-8bf7-f479e9e2c51f",
          "migrations_dir": "migrations",
        },
      ],
      "workflows": [
        {
          "name": "respondkit-translation-staging",
          "binding": "TRANSLATION_WORKFLOW",
          "class_name": "TranslationWorkflow",
        },
        {
          "name": "respondkit-message-staging",
          "binding": "MESSAGE_WORKFLOW",
          "class_name": "MessageWorkflow",
        },
      ],
    },
  },
}
