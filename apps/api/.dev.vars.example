# External provider credentials are intentionally absent from local development.
# Add separately provisioned development credentials only when running live tests.
GEMINI_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
SESSION_SIGNING_KEY=

# Optional: per-inbox product-backend identity secrets (at least 32 characters each).
# IDENTITY_SIGNING_KEYS={"inbox_example_public":"replace-with-a-random-backend-secret"}

# Optional translation capability: enable only the inboxes that should call Gemini.
TRANSLATION_ENABLED_INBOXES=["inbox_example_public"]

# Optional PostHog activity: JSON inbox-to-endpoint mapping; credentials stay server-side.
# POSTHOG_ACTIVITY_INBOXES={"inbox_example":{"host":"https://eu.posthog.com","projectId":123,"endpoint":"respondkit_customer_activity_v1","version":2}}
# POSTHOG_API_KEY_inbox_example=replace-with-endpoint-read-only-key
