{
  "name": "@respondkit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp exec wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy:staging": "vp exec wrangler deploy --env staging",
    "dev": "vp exec wrangler dev",
    "test": "vp test --config vitest.config.ts",
    "typegen": "vp exec wrangler types --env-interface CloudflareBindings",
    "db:generate": "vp exec drizzle-kit generate",
    "db:migrate:local": "vp exec wrangler d1 migrations apply respondkit --local",
    "db:migrate:staging": "vp exec wrangler d1 migrations apply respondkit-staging --remote --env staging",
    "config:apply": "vp exec tsx scripts/config-apply.ts",
    "discord:commands:apply": "vp exec tsx scripts/discord-register.ts"
  },
  "dependencies": {
    "@respondkit/conversations": "workspace:*",
    "@respondkit/discord": "workspace:*",
    "@respondkit/protocol": "workspace:*",
    "@respondkit/translation": "workspace:*",
    "@respondkit/workspaces": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
