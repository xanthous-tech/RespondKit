{
  "name": "respondkit",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "version:set": "node scripts/set-release-version.ts",
    "release:check": "node scripts/validate-npm-release.ts",
    "check": "vp check",
    "test:all": "vp run -r test",
    "build:all": "vp run -r build",
    "build:npm": "vp run -r build:npm",
    "check:npm": "vp exec tsx scripts/check-npm-packages.ts",
    "pack:npm": "vp exec tsx scripts/pack-npm-packages.ts",
    "ready": "vp check && vp run test:release && vp run localization:check && vp run -r test && vp run -r build",
    "deploy:staging": "vp -C apps/api run deploy:staging",
    "deploy:web": "vp -C apps/web run deploy",
    "dev:widget": "vp -C apps/widget dev",
    "dev:web": "vp -C apps/web dev",
    "dev:api": "vp -C apps/api run dev",
    "db:generate": "vp -C apps/api run db:generate",
    "db:migrate:local": "vp -C apps/api run db:migrate:local",
    "db:migrate:staging": "vp -C apps/api run db:migrate:staging",
    "config:apply": "vp -C apps/api exec tsx scripts/config-apply.ts",
    "discord:commands:apply": "vp -C apps/api exec tsx scripts/discord-register.ts",
    "localization:generate": "vp exec node --import tsx scripts/generate-localizations.ts",
    "localization:check": "vp exec node --import tsx scripts/generate-localizations.ts --check",
    "test:release": "node --test scripts/npm-release.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@respondkit/paraglide-android": "workspace:*",
    "@respondkit/paraglide-ios": "workspace:*",
    "publint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
