  "respondkit_support_messages": "Support messages",
  "respondkit_latest": "Latest messages",
  "respondkit_new_count": [
    {
      "declarations": ["input count", "local category = count: plural"],
      "selectors": ["category"],
      "match": { "category=*": "{count} new" }
    }
  ],
  "respondkit_show_new": [
    {
      "declarations": ["input count", "local category = count: plural"],
      "selectors": ["category"],
      "match": {
        "category=one": "Show {count} new message",
        "category=*": "Show {count} new messages"
      }
    }
  ],
  "respondkit_conversations_unread": [
    {
      "declarations": ["input count", "local category = count: plural"],
      "selectors": ["category"],
      "match": { "category=*": "Conversations · {count} unread" }
    }
  ],
