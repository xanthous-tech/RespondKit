  "respondkit_new_count": [
    {
      "declarations": ["input count", "local category = count: plural"],
      "selectors": ["category"],
      "match": {
        "category=*": "{count} 条新消息"
      }
    }
  ],
  "respondkit_show_new": [
    {
      "declarations": ["input count", "local category = count: plural"],
      "selectors": ["category"],
      "match": {
        "category=*": "显示 {count} 条新消息"
      }
    }
  ],
  "respondkit_conversations_unread": [
    {
      "declarations": ["input count", "local category = count: plural"],
      "selectors": ["category"],
      "match": {
        "category=*": "对话 · {count} 条未读"
      }
    }
  ],
